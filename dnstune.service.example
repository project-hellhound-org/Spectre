# Optional systemd unit for running dnstune fully detached from any
# terminal session — survives logout, not just the REPL. Copy to
# /etc/systemd/system/dnstune.service and edit the paths/target below.
#
#   sudo cp dnstune.service.example /etc/systemd/system/dnstune.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now dnstune
#   journalctl -u dnstune -f          # follow its output
#   dnstune-logs                      # or view findings via the log portal
#
# This intentionally does NOT use the interactive REPL (--no-repl) since
# there's no terminal attached under systemd. Use the dashboard's
# in-browser swap control, or `systemctl restart dnstune` with an edited
# ExecStart target, to change targets.

[Unit]
Description=DNS Tunnel Detector
After=network.target

[Service]
Type=simple
# Adjust to your venv's dnstune path (e.g. `which dnstune` while the venv is active)
ExecStart=/path/to/venv/bin/dnstune 10.0.0.0/24 --no-repl --no-browser --port 5000
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
